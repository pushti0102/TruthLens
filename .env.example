# ==============================================================================
# TruthLens Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH SECURE LOCAL VALUES.
# NEVER COMMIT REAL PRIVATE KEYS, PASSWORDS, OR SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Application Environment (development, staging, production)
TRUTHLENS_ENV=development

# ------------------------------------------------------------------------------
# Cryptography & Provenance Signing (ECDSA NIST P-256 / SECP256R1)
# ------------------------------------------------------------------------------
# Active Signing Key Identifier
TRUTHLENS_ACTIVE_KEY_ID=tl-key-ecdsa-2026-v1

# Paths to Local Cryptographic Key Files (outside webroot)
# Note: Keep file permissions 0600 on UNIX systems.
TRUTHLENS_ECDSA_PRIVATE_KEY_PATH=secrets/truthlens_signing_private.pem
TRUTHLENS_ECDSA_PRIVATE_KEY_PASSWORD=change_this_to_a_secure_passphrase_for_private_key
TRUTHLENS_ECDSA_PUBLIC_KEY_PATH=secrets/truthlens_signing_public.pem

# Path to Trusted Public Keys Registry (JSON format)
TRUTHLENS_TRUSTED_KEYS_PATH=secrets/trusted_keys_registry.json

# ------------------------------------------------------------------------------
# Authenticated Encryption (AES-256-GCM)
# ------------------------------------------------------------------------------
# Active Symmetric Encryption Key ID
TRUTHLENS_AES_KEY_ID=tl-aes-2026-v1

# Master 256-bit AES Key (Base64-encoded, 32 raw bytes)
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TRUTHLENS_AES_MASTER_KEY_B64=REPLACE_WITH_BASE64_ENCODED_32_BYTES_AES_KEY==

# ------------------------------------------------------------------------------
# Secure Image Upload Validation Limits
# ------------------------------------------------------------------------------
# Maximum upload file size in bytes (10 MB = 10485760 bytes)
TRUTHLENS_UPLOAD_MAX_BYTES=10485760

# Maximum allowed image width and height in pixels
TRUTHLENS_UPLOAD_MAX_WIDTH=8192
TRUTHLENS_UPLOAD_MAX_HEIGHT=8192

# Maximum total pixels to prevent decompression bombs (25 Megapixels)
TRUTHLENS_UPLOAD_MAX_PIXELS=25000000

# Directory for verified media storage (MUST be outside public webroot)
TRUTHLENS_STORAGE_DIR=storage/verified_assets

# ------------------------------------------------------------------------------
# Rate Limiting Configuration
# ------------------------------------------------------------------------------
# General API endpoints rate limit
TRUTHLENS_RATE_LIMIT_DEFAULT=60/minute

# Resource-intensive endpoints (e.g. image verification / AI inference / file upload)
TRUTHLENS_RATE_LIMIT_ANALYSIS=10/minute

# Optional Redis URL for multi-worker distributed rate limiting
# In single-worker / local dev mode, in-memory limiter is used automatically.
# TRUTHLENS_REDIS_URL=redis://localhost:6379/0

# Trusted reverse proxy IPs (comma-separated CIDR or IP addresses)
# Required when deployed behind NGINX, Cloudflare, or AWS ALB to prevent IP spoofing
TRUTHLENS_TRUSTED_PROXIES=127.0.0.1,::1
